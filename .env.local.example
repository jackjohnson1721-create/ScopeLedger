# -----------------------------------------------------------------------------
# ScopeLedger environment template
# -----------------------------------------------------------------------------
# Copy to .env.local for local dev; populate real values in Vercel for
# preview/production. NEVER commit a filled-in .env.local.
# -----------------------------------------------------------------------------

# -- Public / app ------------------------------------------------------------
# Canonical public URL; used for OAuth redirects and absolute links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -- Supabase ----------------------------------------------------------------
# Local: `supabase start` prints these. Prod: Supabase project -> API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key. Server-only. Used by webhook handlers and cron jobs.
# NEVER expose to the browser and never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# -- Anthropic (LLM extraction + classification) -----------------------------
# Sonnet 4.6 for invoice extraction, Haiku 4.5 for vendor classification.
ANTHROPIC_API_KEY=

# -- AWS Textract (primary OCR) ---------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# -- Azure Document Intelligence (OCR fallback) -----------------------------
AZURE_DOC_INTELLIGENCE_ENDPOINT=
AZURE_DOC_INTELLIGENCE_KEY=

# -- Postmark (inbound mail via MailboxHash -> org slug) --------------------
POSTMARK_SERVER_TOKEN=
# Shared secret used to verify inbound webhook signature.
POSTMARK_INBOUND_WEBHOOK_SECRET=

# -- Zoho (CRM + Books + Payments + Subscriptions) --------------------------
# Create an OAuth client at https://api-console.zoho.com/.
# Required scopes: ZohoCRM.modules.ALL, ZohoBooks.fullaccess.all,
# ZohoSubscriptions.subscriptions.ALL, ZohoSubscriptions.customers.ALL.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_ACCOUNTS_BASE_URL=https://accounts.zoho.com
# Shared secret configured on each Zoho webhook; HMAC-SHA256.
ZOHO_WEBHOOK_SECRET=

# -- CMMS (read-only in V1; Nuvolo bidirectional is V1.1) -------------------
CENSITRAC_API_BASE_URL=
CENSITRAC_API_KEY=
SPM_API_BASE_URL=
SPM_API_KEY=
NUVOLO_API_BASE_URL=
NUVOLO_API_KEY=

# -- Monitoring / observability ---------------------------------------------
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SLACK_DEPLOY_WEBHOOK_URL=
